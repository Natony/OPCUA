<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_control.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_control"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- ─── LEFT PANEL: Manual + Auto small ─── -->
    <LinearLayout
        android:id="@+id/left_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">

        <!-- Manual controls -->
        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnManualForward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Forward"
            app:iconOnDrawable="@drawable/ic_shuttle_forward_on"
            app:iconOffDrawable="@drawable/ic_shuttle_forward_off"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnManualReverse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Reverse"
            app:iconOnDrawable="@drawable/ic_shuttle_reverse_on"
            app:iconOffDrawable="@drawable/ic_shuttle_reverse_off"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnManualUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Up"
            app:iconOnDrawable="@drawable/ic_shuttle_up_on"
            app:iconOffDrawable="@drawable/ic_shuttle_up_off"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnManualDown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Down"
            app:iconOnDrawable="@drawable/ic_shuttle_down_on"
            app:iconOffDrawable="@drawable/ic_shuttle_down_off"
            app:initialValue="false"/>

        <!-- Auto small controls -->
        <com.example.s7opcuaapp.ui.view.IntControlItemView
            android:id="@+id/btnPickPallets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Pick Pallets"
            app:iconOnDrawable="@drawable/ic_pallets_plus_on"
            app:iconOffDrawable="@drawable/ic_pallets_plus_off"
            app:initialValue="0"/>

        <com.example.s7opcuaapp.ui.view.IntControlItemView
            android:id="@+id/btnTakePallets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Take Pallets"
            app:iconOnDrawable="@drawable/ic_pallets_minus_on"
            app:iconOffDrawable="@drawable/ic_pallets_minus_off"
            app:initialValue="0"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnPickPallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Pick Pallet"
            app:iconOnDrawable="@drawable/ic_pallet_plus_on"
            app:iconOffDrawable="@drawable/ic_pallet_plus_off"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnTakePallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Take Pallet"
            app:iconOnDrawable="@drawable/ic_pallet_minus_on"
            app:iconOffDrawable="@drawable/ic_pallet_minus_off"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnStackA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Stack A"
            app:iconOnDrawable="@drawable/ic_stack_pallets_a_on"
            app:iconOffDrawable="@drawable/ic_stack_pallets_a_off"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnStackB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Stack B"
            app:iconOnDrawable="@drawable/ic_stack_pallets_b_on"
            app:iconOffDrawable="@drawable/ic_stack_pallets_b_off"
            app:initialValue="false"/>
    </LinearLayout>


    <!-- ─── CENTER PANEL ─── -->
    <LinearLayout
        android:id="@+id/center_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- Positions strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPositions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:overScrollMode="never"/>

        <!-- RunPoint cards -->
        <com.example.s7opcuaapp.ui.view.RunPointCardView
            android:id="@+id/card_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardMode="start"/>

        <com.example.s7opcuaapp.ui.view.RunPointCardView
            android:id="@+id/card_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardMode="end"/>

        <com.example.s7opcuaapp.ui.view.RunPointCardView
            android:id="@+id/card_actual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardMode="actual"/>

        <!-- Function selector -->
        <com.example.s7opcuaapp.ui.view.FunctionSelectorView
            android:id="@+id/function_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <!-- Center controls -->
        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Power"
            app:iconOnDrawable="@drawable/ic_power_on"
            app:iconOffDrawable="@drawable/ic_power_off"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnBuzzer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Buzzer"
            app:iconOnDrawable="@drawable/ic_buzzer_on"
            app:iconOffDrawable="@drawable/ic_buzzer_off"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnHandlingMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Handling Mode"
            app:iconOnDrawable="@drawable/ic_fifo"
            app:iconOffDrawable="@drawable/ic_lifo"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnDirection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Direction"
            app:iconOnDrawable="@drawable/ic_direction_a"
            app:iconOffDrawable="@drawable/ic_direction_b"
            app:initialValue="false"/>

        <com.example.s7opcuaapp.ui.view.BoolControlItemView
            android:id="@+id/btnCountPallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="Count Pallet"
            app:iconOnDrawable="@drawable/ic_count_pallet_on"
            app:iconOffDrawable="@drawable/ic_count_pallet_off"
            app:initialValue="false"/>
    </LinearLayout>


    <!-- ─── RIGHT PANEL (mirror LEFT) ─── -->
    <LinearLayout
        android:id="@+id/right_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">

        <!-- (Bạn có thể đặt lại thứ tự hoặc ẩn/show theo chế độ Manual/Auto) -->
        <!-- Ví dụ same as left_panel but mirror order or dynamic visibility -->
    </LinearLayout>

</LinearLayout>
